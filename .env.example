# ===== กินจริง (KinJing) — ตัวแปรที่ต้องตั้งใน Vercel > Settings > Environment Variables =====
DATABASE_URL=
SESSION_SECRET=
ADMIN_PASSWORD=
CRON_SECRET=
BLOB_READ_WRITE_TOKEN=

# --- ชำระค่าสมาชิกด้วย PromptPay QR (สร้าง QR เอง ไม่ใช้ API ธนาคาร) ---
# เบอร์มือถือ/เลขบัตรประชาชนที่ผูก PromptPay ของผู้ดูแลระบบ
PROMPTPAY_ID=0638733553
# ชื่อบัญชีผู้รับ (ไทย/อังกฤษ คั่นด้วยจุลภาค) ใช้เทียบกับชื่อผู้รับในสลิป เช่น ปรีชา,PREECHA
PROMPTPAY_RECEIVER_NAMES=
# (ไม่บังคับ) เลขบัญชีธนาคาร 4 หลักท้าย สำรองไว้เทียบเมื่อสลิปแสดงเลขบัญชีแทนชื่อ
PROMPTPAY_ACCOUNT_LAST_DIGITS=

# --- ตรวจสลิปอัตโนมัติ (SlipOK: https://slipok.com) ---
SLIPOK_BRANCH_ID=
SLIPOK_API_KEY=
# true = ให้ SlipOK บันทึกและเช็คสลิปซ้ำด้วย (ระบบเช็ค Ref ซ้ำกับฐานข้อมูลเองอยู่แล้ว)
SLIPOK_LOG=false

# --- ตรวจภาพ/วิดีโอไม่เหมาะสม (Sightengine: https://sightengine.com) ---
# ถ้าไม่ตั้งค่า ระบบจะข้ามการตรวจภาพ (ยังตรวจคำต้องห้ามในข้อความ)
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# --- ระบบแบ่งรายได้ให้ผู้ใช้ (ปิดไว้ตามข้อปรับแก้) ---
PAYOUTS_ENABLED=false
